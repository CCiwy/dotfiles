# new splits on CTRL + ALT + ARROW
keybind = ctrl+alt+arrow_down=new_split:down
keybind = ctrl+alt+arrow_up=new_split:up
keybind = ctrl+alt+arrow_left=new_split:left
keybind = ctrl+alt+arrow_right=new_split:right

# move between splits on CTRL + SHIFT + ARROW
keybind = ctrl+shift+arrow_down=goto_split:down
keybind = ctrl+shift+arrow_up=goto_split:up
keybind = ctrl+shift+arrow_left=goto_split:left
keybind = ctrl+shift+arrow_right=goto_split:right

# toggle fullscreen split on CTRL + SHIFT + M
keybind = ctrl+shift+M=toggle_split_zoom
